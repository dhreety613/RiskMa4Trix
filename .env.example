# --- Database ---
DATABASE_URL=postgresql+psycopg://matrix:matrix@postgres:5432/matrix

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173

# --- Frontend -> API base URL (Vite env var, build-time) ---
VITE_API_URL=http://localhost:8000

# --- SEC EDGAR ---
# Required by SEC's fair-access policy: "<app name> <contact email>"
SEC_USER_AGENT=ma3trix-app your-email@example.com

# --- LLM (optional, OFF by default) ---
# Only ever used for: one-line risk titles, mitigation wording polish.
# Never used for classification or scoring decisions.
LLM_ENABLED=false
LLM_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Postgres (used by docker-compose for the postgres service itself) ---
POSTGRES_USER=matrix
POSTGRES_PASSWORD=matrix
POSTGRES_DB=matrix
